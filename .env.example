# 数据与推送（与 JCKX 共用；真实值只存在于生产 .env，禁止提交）
TUSHARE_TOKEN=
WECOM_WEBHOOK=

# 报告访问（沿用 JCKX 密码体系；只走 WireGuard 内网）
JCKX_PASSWORD=
JCKX_TOKEN=
JCKX_BIND_HOST=127.0.0.1
JCKX_AUTH_PORT=8082
JCKX_REPORT_BASE_URL=http://10.66.0.1/strategy
JCKX_PUBLIC_REPORTS=0

# AI（NLP 事实抽取与报告叙事；与 JCKX 共用 DeepSeek 主审 key）
AI_PRIMARY_BASE_URL=https://api.deepseek.com
AI_PRIMARY_API_KEY=
AI_PRIMARY_MODEL=deepseek-v4-flash
TAIL_AI_PRIMARY_DISABLE_THINKING=1
TAIL_AI_JSON_MODE=1

# 数据源与调度
SHARED_EVENT_CACHE_DIR=/home/ubuntu/jckx-tail-overnight/cache
SHARED_MINUTE_HISTORY_DIR=/home/ubuntu/jckx-tail-overnight/data/minute_history
TUSHARE_SLEEP_SEC=0.35
TUSHARE_RETRY=3
MIN_CIRC_MV=110
MIN_LIST_DAYS=60
MIN_AMOUNT_20D=150000000
PRIMARY_MAX=3
WATCH_MAX=5
RISK_CONTROL_MAX=3
NLP_MAX_ITEMS=15
NLP_FETCH_TIMEOUT_SEC=15
