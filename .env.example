# 数据与推送（与 JCKX 共用；真实值只存在于生产 .env，禁止提交）
TUSHARE_TOKEN=
WECOM_WEBHOOK=

# 报告访问（沿用 JCKX 密码体系；只走 WireGuard 内网）
JCKX_PASSWORD=
JCKX_TOKEN=
JCKX_BIND_HOST=127.0.0.1
JCKX_AUTH_PORT=8082
JCKX_REPORT_BASE_URL=http://10.66.0.1/strategy
JCKX_PUBLIC_REPORTS=0

# AI（NLP 事实抽取与报告叙事；与 JCKX 共用 DeepSeek 主审 key）
AI_PRIMARY_BASE_URL=https://api.deepseek.com
AI_PRIMARY_API_KEY=
AI_PRIMARY_MODEL=deepseek-v4-flash
TAIL_AI_PRIMARY_DISABLE_THINKING=1
TAIL_AI_JSON_MODE=1

# 数据源与调度
SHARED_EVENT_CACHE_DIR=/home/ubuntu/jckx-tail-overnight/cache
SHARED_EVENT_CACHE_VERSION=
SHARED_EVENT_CACHE_MAX_BYTES=20971520
SHARED_MINUTE_HISTORY_DIR=/home/ubuntu/jckx-tail-overnight/data/minute_history
TUSHARE_SLEEP_SEC=0.35
TUSHARE_RETRY=3
MIN_CIRC_MV=50
ENTRY_CONFIRM_CUTOFF=10:15
MIN_LIST_DAYS=60
MIN_AMOUNT_20D=150000000
PRIMARY_MAX=3
PRIMARY_MAX_SAME_INDUSTRY=2
WATCH_MAX=5
RISK_CONTROL_MAX=3
NLP_MAX_ITEMS=15
NLP_IMPACT_MAX_ITEMS=30
NLP_FETCH_TIMEOUT_SEC=15
MIN_DAILY_ROWS=3000
MIN_BASIC_ROWS=2500
MIN_BASIC_COVERAGE=0.75
MIN_NEWS_COVERAGE=0.34
MIN_EVIDENCE_CONFIDENCE=0.30
REQUIRE_LLM_IMPACT=1
MIN_LLM_IMPACT_COVERAGE=0.50
MIN_PRIMARY_SCORE=62
MIN_PRIMARY_PROB=0.52
MIN_WATCH_SCORE=55
PRIMARY_RULE_MIN_SCORE=75
# 热榜新推荐宁缺毋滥：最多 5 支，同时满足最终分、模型概率（若有）和高级因子覆盖。
FRESH_RECOMMENDATION_COUNT=5
FRESH_MIN_SCORE=62
FRESH_MIN_PROBABILITY=0.52
MIN_PREMIUM_FACTOR_COVERAGE=0.60
MIN_HOT_CANDIDATES_COVERED=50
# 周末可能继续使用最近交易日热榜；超过该时长视为陈旧数据并拒绝运行。
MAX_HOT_RANK_AGE_HOURS=72
STOCK_INTENT_RULE_LIMIT=30
STOCK_INTENT_LLM_LIMIT=12
ENABLE_STOCK_INTENT_LLM=1
HOT_PERSISTENCE_LOOKBACK_DAYS=10
MAX_ONE_DAY_RISK=0.65
MIN_CLIMAX_PROBABILITY=0.60
MIN_CLIMAX_PERSISTENCE=0.65
MAX_CLIMAX_ONE_DAY_RISK=0.40
TRACKING_INTENT_LLM_LIMIT=20
CONTINUATION_RISE_THRESHOLD=0.55
OUTCOME_ROUNDTRIP_COST_BPS=40
MODEL_MIN_WALKFORWARD_FOLDS=4
MODEL_MIN_STABILITY_DAYS=20
REPLAY_MINUTES=1
# Tushare 6000 积分不等于实时行情权限；另购实时分钟权限后再开启。
ENABLE_TUSHARE_REALTIME_MINUTE=0
# 筹码接口逐股消耗较高，只查热榜前 N 名；续跟踪股票不受此限制。
CYQ_CANDIDATE_LIMIT=30
# 集合竞价为 Tushare 独立权限；开启后使用 stk_auction、stk_auction_o、stk_auction_c。
ENABLE_TUSHARE_OPEN_AUCTION=0
# 防守模式“避风港”门槛：行业资金必须是净流入且有广度，个股结构必须稳定。
HAVEN_MIN_SECTOR_LHB_NET_YI=1.0
HAVEN_MIN_SECTOR_LHB_POSITIVE_STOCKS=2
HAVEN_MIN_SECTOR_LHB_POSITIVE_SHARE=0.60
HAVEN_MIN_MA20_SLOPE_PCT=0
HAVEN_MIN_CLOSE_LOCATION=0.55
HAVEN_MAX_MA20_DISTANCE_PCT=12
# 旧市场方向模型已知劣于基线，必须显式开启才允许覆盖规则。
ALLOW_UNAPPROVED_MARKET_MODEL=0
ALLOW_UNAPPROVED_SECTOR_MODEL=0
ALLOW_UNAPPROVED_STOCK_MODEL=0
TAIL_ENTRY_MAX=5
TAIL_HOT_DISCOVERY_RANK=10
